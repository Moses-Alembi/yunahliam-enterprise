# Copy to server/.env and fill in. Never commit the real .env.

PORT=3000
# The public https address of the store. Pesapal notifies PUBLIC_URL/api/payments/pesapal/ipn and returns
# customers to PUBLIC_URL/order.html after they pay.
PUBLIC_URL=http://localhost:3000
# Set to true when running behind a reverse proxy / hosting platform (so rate limits see real client IPs).
TRUST_PROXY=false
# DB_PATH=./data/store.db

# Delivery fees in KSh (pickup is always free)
DELIVERY_FEE_NAIROBI=300
DELIVERY_FEE_COUNTRYWIDE=600

# --- Pesapal (API 3.0) ---
# Sandbox keys: https://developer.pesapal.com (sandbox/demo merchant credentials).
# Live keys: your Pesapal merchant dashboard, after your business account is approved.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Optional. Left empty, the server finds or registers PUBLIC_URL/api/payments/pesapal/ipn with Pesapal
# on the first payment and logs the id; paste it here to skip that lookup.
PESAPAL_IPN_ID=
